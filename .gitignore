# ==============================================================================
# Extensive .gitignore for Static Web & Development
# ==============================================================================

# Operating System Files
# ----------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# IDEs, Editors & Workspaces
# --------------------------
.idea/
.vscode/
*.swp
*.swo
*.swn
*.bak
*~
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Environment Variables & Credentials (Never Commit)
# ---------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Logs & Runtime Dumps
# --------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.seed
*.pid.lock

# Temporary, Cache & Build Directories
# ------------------------------------
.cache/
tmp/
temp/
dist/
build/
out/
.sass-cache/

# Local Agent & Tooling Artifacts
# -------------------------------
graphify-out/
.system_generated/
